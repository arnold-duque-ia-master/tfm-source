{
  "id": "gcq5-hvdx",
  "name": "Registros de Vacunación contra Fiebre Aftosa y Especies Asociadas en el Departamento del Vichada",
  "assetType": "dataset",
  "attribution": "Secretaria de agricultura y desarrollo rural del Vichada",
